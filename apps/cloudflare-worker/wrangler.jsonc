{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "speechoptimizer-web",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "../../prototype/dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/health/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "speechoptimizer-local",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "ANALYSIS_QUEUE", "queue": "speechoptimizer-local-analysis" }
    ],
    "consumers": [
      {
        "queue": "speechoptimizer-local-analysis",
        "max_batch_size": 1,
        "max_retries": 2,
        "dead_letter_queue": "speechoptimizer-local-analysis-dlq"
      }
    ]
  },
  "workflows": [
    {
      "binding": "ANALYSIS_WORKFLOW",
      "name": "speechoptimizer-local-analysis",
      "class_name": "SpeechAnalysisWorkflow"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "APP_ENV": "local",
    "APP_VERSION": "local",
    "RESOURCE_NAMESPACE": "speechoptimizer-local",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
    "STORAGE_LIMIT_BYTES": "838860800",
    "PAYMENTS_ENABLED": "false",
    "MAX_AUDIO_BYTES": "10485760",
    "MAX_AUDIO_DURATION_MS": "300000",
    "ANONYMOUS_MAX_AUDIO_DURATION_MS": "60000",
    "FREE_TIER_GUARD_LEVEL": "0"
  },
  "env": {
    "local": {
      "name": "speechoptimizer-web-local",
      "d1_databases": [
        { "binding": "DB", "database_name": "speechoptimizer-local", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [
        { "binding": "AUDIO_BUCKET", "bucket_name": "speechoptimizer-local-private" }
      ],
      "queues": {
        "producers": [{ "binding": "ANALYSIS_QUEUE", "queue": "speechoptimizer-local-analysis" }],
        "consumers": [{ "queue": "speechoptimizer-local-analysis", "max_batch_size": 1, "max_retries": 2,
          "dead_letter_queue": "speechoptimizer-local-analysis-dlq" }]
      },
      "workflows": [{ "binding": "ANALYSIS_WORKFLOW", "name": "speechoptimizer-local-analysis",
        "class_name": "SpeechAnalysisWorkflow" }],
      "triggers": { "crons": ["17 3 * * *"] },
      "vars": {
        "APP_ENV": "local",
        "APP_VERSION": "local",
        "RESOURCE_NAMESPACE": "speechoptimizer-local",
        "STORAGE_PROVIDER": "r2",
        "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173",
        "R2_BUCKET_NAME": "speechoptimizer-local-private",
        "STORAGE_LIMIT_BYTES": "838860800",
        "PAYMENTS_ENABLED": "false",
        "MAX_AUDIO_BYTES": "10485760",
        "MAX_AUDIO_DURATION_MS": "300000",
        "ANONYMOUS_MAX_AUDIO_DURATION_MS": "60000",
        "FREE_TIER_GUARD_LEVEL": "0",
        // 这是完整的 POST endpoint；中转环境只能替换为经审查的 HTTPS 地址，不能携带凭据或 query/fragment。
        "OPENAI_STT_URL": "https://aihubmix.com/v1/audio/transcriptions",
        // 该字段进入 multipart 的 model；中转别名必须兼容 verbose_json 与逐词时间戳响应。
        "OPENAI_STT_MODEL": "whisper-1",
        "COOKIE_SECRET": "local-development-cookie-secret-only"
      }
    },
    "preview": {
      "name": "speechoptimizer-web-preview",
      "d1_databases": [
        { "binding": "DB", "database_name": "speechoptimizer-preview",
          "database_id": "d899b126-65ca-4689-99d4-ed462fa15959", "migrations_dir": "migrations" }
      ],
      "queues": {
        "producers": [{ "binding": "ANALYSIS_QUEUE", "queue": "speechoptimizer-preview-analysis" }],
        "consumers": [{ "queue": "speechoptimizer-preview-analysis", "max_batch_size": 1, "max_retries": 2,
          "dead_letter_queue": "speechoptimizer-preview-analysis-dlq" }]
      },
      "workflows": [{ "binding": "ANALYSIS_WORKFLOW", "name": "speechoptimizer-preview-analysis",
        "class_name": "SpeechAnalysisWorkflow" }],
      "triggers": { "crons": ["17 3 * * *"] },
      "vars": {
        "APP_ENV": "preview",
        "APP_VERSION": "preview",
        "RESOURCE_NAMESPACE": "speechoptimizer-preview",
        "STORAGE_PROVIDER": "supabase",
        "ALLOWED_ORIGINS": "https://speechoptimizer-web-preview.bb382978203.workers.dev,https://speak-confidently.top",
        "SUPABASE_URL": "https://qnmxxvnypmfzwclyyfhr.supabase.co",
        "SUPABASE_STORAGE_BUCKET": "speechoptimizer-preview-audio",
        "STORAGE_LIMIT_BYTES": "838860800",
        "PAYMENTS_ENABLED": "false",
        "MAX_AUDIO_BYTES": "10485760",
        "MAX_AUDIO_DURATION_MS": "300000",
        "ANONYMOUS_MAX_AUDIO_DURATION_MS": "60000",
        "FREE_TIER_GUARD_LEVEL": "0",
        "QUOTA_EXEMPT_ACCOUNT_EMAILS": "bb382978203@gmail.com",
        "ADMIN_ACCOUNT_EMAILS": "bb382978203@gmail.com",
        // Preview 指向 owner 选定的 AIHubMix 完整 POST endpoint；WebM、verbose_json 与逐词时间戳兼容性必须由真实 Preview E2E 验证，API key 仅存 Worker Secret。
        "OPENAI_STT_URL": "https://aihubmix.com/v1/audio/transcriptions",
        // 该值进入 multipart 的 model；AIHubMix 对 whisper-1 的真实兼容性与变更模型后的行为均须重新完成 Preview E2E。
        "OPENAI_STT_MODEL": "whisper-1",
        // 此公开 key 由 /health 返回给前端渲染；验证密钥必须保存在 Worker Secret。
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEovEhmSiSUpQ9BN"
      }
    },
    "production": {
      "name": "speechoptimizer-web",
      "d1_databases": [
        { "binding": "DB", "database_name": "speechoptimizer-production",
          "database_id": "d92dd680-b8e2-4681-b904-12a888780198", "migrations_dir": "migrations" }
      ],
      "queues": {
        "producers": [{ "binding": "ANALYSIS_QUEUE", "queue": "speechoptimizer-analysis" }],
        "consumers": [{ "queue": "speechoptimizer-analysis", "max_batch_size": 1, "max_retries": 2,
          "dead_letter_queue": "speechoptimizer-analysis-dlq" }]
      },
      "workflows": [{ "binding": "ANALYSIS_WORKFLOW", "name": "speechoptimizer-analysis",
        "class_name": "SpeechAnalysisWorkflow" }],
      "triggers": { "crons": ["17 3 * * *"] },
      "vars": {
        "APP_ENV": "production",
        "APP_VERSION": "production",
        "RESOURCE_NAMESPACE": "speechoptimizer-production",
        "STORAGE_PROVIDER": "supabase",
        "ALLOWED_ORIGINS": "https://speak-confidently.top,https://speechoptimizer-web.bb382978203.workers.dev",
        "SUPABASE_URL": "https://qnmxxvnypmfzwclyyfhr.supabase.co",
        "SUPABASE_STORAGE_BUCKET": "speechoptimizer-production-audio",
        "STORAGE_LIMIT_BYTES": "838860800",
        "PAYMENTS_ENABLED": "false",
        "MAX_AUDIO_BYTES": "10485760",
        "MAX_AUDIO_DURATION_MS": "300000",
        "ANONYMOUS_MAX_AUDIO_DURATION_MS": "60000",
        "FREE_TIER_GUARD_LEVEL": "0",
        // Production 显式保持测试白名单为空，既对齐 generated Env 契约，也避免测试账号获得免限额或管理员权限。
        "QUOTA_EXEMPT_ACCOUNT_EMAILS": "",
        "ADMIN_ACCOUNT_EMAILS": "",
        // 这是完整的 POST endpoint；Production 使用审查后的 HTTPS endpoint，不能携带凭据或 query/fragment。
        "OPENAI_STT_URL": "https://aihubmix.com/v1/audio/transcriptions",
        // 该字段进入 multipart 的 model；中转别名必须兼容 verbose_json 与逐词时间戳响应。
        "OPENAI_STT_MODEL": "whisper-1",
        // 此 key 与 Preview 共用同一 widget；正式验证密钥必须在发布前独立存入 Worker Secret。
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEovEhmSiSUpQ9BN"
      }
    }
  }
}
