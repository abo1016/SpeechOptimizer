{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "noEmit": true,
    "noImplicitAny": false,
    "strict": true,
    "useUnknownInCatchVariables": false,
    "types": []
  },
  "include": ["src/**/*.js", "src/**/*.d.ts", "worker-configuration.d.ts"]
}
