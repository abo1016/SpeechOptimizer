# 服务监听地址；本地默认仅监听回环地址，避免无意暴露到局域网。
HOST=127.0.0.1
PORT=8787

# 本地持久化目录；核心任务、音频对象和账户计费快照均写入此目录。
MVP_DATA_DIRECTORY=.data/mvp-server

# 浏览器来源允许列表，多个完整 Origin 使用英文逗号分隔；生产部署使用 https://speak-confidently.top。
ALLOWED_ORIGINS=http://localhost:5173
# Cookie 签名密钥；生产环境必须使用高熵值且长度不少于 24 字符。
COOKIE_SECRET=replace-with-a-random-cookie-secret
# Waffo Webhook 来源地址允许列表与单来源每分钟请求上限。
WAFFO_ALLOWED_SOURCES=127.0.0.1
WEBHOOK_REQUESTS_PER_MINUTE=60

# 非 WAV 媒体通过 ffprobe 读取真实时长；路径可指向受控的 ffprobe 可执行文件。
FFPROBE_PATH=ffprobe
# OpenAI STT 与结构化反馈；密钥只在服务端环境读取。
OPENAI_API_KEY=replace-me
OPENAI_STT_URL=https://api.openai.com/v1/audio/transcriptions
OPENAI_FEEDBACK_URL=https://api.openai.com/v1/responses
OPENAI_FEEDBACK_MODEL=gpt-4o-mini

# 登录服务可独立于 AI/支付切换到真实 Provider；production 会启用 Secure Cookie、Google OAuth 与 Resend Magic Link。
AUTH_MODE=mock
# Google OAuth 授权和服务端 code 交换配置。URL 均有官方默认值，通常只需配置 Client ID/Secret。
GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
# Magic Link 使用 Resend HTTP API；发件域名必须先在 Resend 验证。
RESEND_API_KEY=replace-me
MAGIC_LINK_FROM=Speak Confidently <no-reply@speak-confidently.top>

# Waffo 官方 SDK 3.0.1 配置。密钥只放在受控服务端环境，禁止提交到仓库或写入日志。
WAFFO_API_KEY=replace-with-waffo-api-key
WAFFO_PRIVATE_KEY=replace-with-merchant-private-key
WAFFO_PUBLIC_KEY=replace-with-waffo-public-key
WAFFO_MERCHANT_ID=replace-with-merchant-id
# 只能填写 SANDBOX 或 PRODUCTION；真实上线仍需完成 Go-Live、合规和支付方式确认。
WAFFO_ENVIRONMENT=SANDBOX
WAFFO_NOTIFY_URL=https://speak-confidently.top/api/v1/webhooks/waffo
WAFFO_SUCCESS_REDIRECT_URL=https://speak-confidently.top/settings/billing/success
WAFFO_FAILED_REDIRECT_URL=https://speak-confidently.top/settings/billing/failed
WAFFO_CANCEL_REDIRECT_URL=https://speak-confidently.top/settings/billing/cancel
WAFFO_GOODS_NAME=Speak Confidently
WAFFO_GOODS_URL=https://speak-confidently.top/settings/billing
# 不替用户决定终端类型；填入真实值前必须完成人工确认，否则生产配置应保持 fail closed。
WAFFO_USER_TERMINAL=REPLACE_AFTER_HUMAN_CONFIRMATION
# 订阅扣款模式与重试次数/间隔必须由商户确认后填写，未确认时生产启动会 fail closed。
WAFFO_SUBSCRIPTION_MODE=REPLACE_AFTER_HUMAN_CONFIRMATION
WAFFO_SUBSCRIPTION_RETRY_POLICY=REPLACE_AFTER_HUMAN_CONFIRMATION
# 可选：如 Waffo 为退款/订阅管理分别配置地址，再显式填写；不填不会伪造地址。
# WAFFO_REFUND_NOTIFY_URL=https://speak-confidently.top/api/v1/webhooks/waffo
# WAFFO_SUBSCRIPTION_MANAGEMENT_URL=https://speak-confidently.top/settings/billing
# Waffo 商品 ID 映射由服务端维护，客户端只能提交受控 productCode。
WAFFO_PRODUCT_IDS_JSON={"pro_monthly":"PROD_replace","pro_yearly":"PROD_replace","minutes_30":"PROD_replace","minutes_100":"PROD_replace","deep_report":"PROD_replace"}
