# 服务监听地址；本地默认仅监听回环地址，避免无意暴露到局域网。
HOST=127.0.0.1
PORT=8787

# 本地持久化目录；核心任务、音频对象和账户计费快照均写入此目录。
MVP_DATA_DIRECTORY=.data/mvp-server

# 浏览器来源允许列表，多个完整 Origin 使用英文逗号分隔。
ALLOWED_ORIGINS=http://localhost:5173
# Cookie 与 Webhook 签名密钥；生产环境必须使用不同的高熵值且长度不少于 24 字符。
COOKIE_SECRET=replace-with-a-random-cookie-secret
WAFFO_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
# Waffo Webhook 来源地址允许列表与单来源每分钟请求上限。
WAFFO_ALLOWED_SOURCES=127.0.0.1
WEBHOOK_REQUESTS_PER_MINUTE=60

# 非 WAV 媒体通过 ffprobe 读取真实时长；路径可指向受控的 ffprobe 可执行文件。
FFPROBE_PATH=ffprobe
# OpenAI STT 与结构化反馈；密钥只在服务端环境读取。
OPENAI_API_KEY=replace-me
OPENAI_STT_URL=https://api.openai.com/v1/audio/transcriptions
OPENAI_FEEDBACK_URL=https://api.openai.com/v1/responses
OPENAI_FEEDBACK_MODEL=gpt-4o-mini

# Google OAuth 授权和服务端 code 交换配置。
GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth.example.invalid/exchange
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
# Magic Link SMTP transport 由组合根注入，环境只配置已验证发件地址。
MAGIC_LINK_FROM=no-reply@example.invalid

# Waffo 官方 SDK client 由组合根注入；商品映射不得由客户端提交。
WAFFO_SUCCESS_URL=https://app.example.invalid/settings/billing
WAFFO_PRODUCT_IDS_JSON={"pro_monthly":"PROD_replace","pro_yearly":"PROD_replace","minutes_30":"PROD_replace","minutes_100":"PROD_replace","deep_report":"PROD_replace"}
