# SpeechOptimizer 本地基础设施环境变量示例。
# 复制为同目录 .env 后可按需覆盖；所有默认凭证仅限本地开发，禁止用于生产。

# PostgreSQL 初始化数据库名称。
POSTGRES_DB=speechoptimizer
# PostgreSQL 本地管理员账号。
POSTGRES_USER=speechoptimizer
# PostgreSQL 本地管理员密码。
POSTGRES_PASSWORD=speechoptimizer_local
# PostgreSQL 映射到宿主机的端口。
POSTGRES_PORT=5432
# 应用连接 PostgreSQL 时使用的标准连接串。
DATABASE_URL=postgresql://speechoptimizer:speechoptimizer_local@localhost:5432/speechoptimizer

# MinIO 本地管理员账号，也是应用开发阶段的 S3 Access Key。
MINIO_ROOT_USER=speechoptimizer
# MinIO 本地管理员密码，也是应用开发阶段的 S3 Secret Key。
MINIO_ROOT_PASSWORD=speechoptimizer_local
# MinIO S3 兼容 API 映射到宿主机的端口。
MINIO_API_PORT=9000
# MinIO 管理控制台映射到宿主机的端口。
MINIO_CONSOLE_PORT=9001
# MinIO 初始化任务幂等创建的私有音频桶名称。
MINIO_BUCKET=speechoptimizer-audio
# 应用访问本地 S3 兼容 API 时使用的端点。
S3_ENDPOINT=http://localhost:9000
# 本地 MinIO 使用的占位区域；MinIO 不校验真实云区域。
S3_REGION=us-east-1
# 本地 MinIO 必须启用路径风格寻址，避免依赖本地域名解析。
S3_FORCE_PATH_STYLE=true

# Mailpit SMTP 服务映射到宿主机的端口。
MAILPIT_SMTP_PORT=1025
# Mailpit Web 管理界面映射到宿主机的端口。
MAILPIT_WEB_PORT=8025
# Mailpit 本地最多保留的邮件数量。
MAILPIT_MAX_MESSAGES=500
# 应用连接本地邮件捕获器时使用的 SMTP 主机。
SMTP_HOST=localhost
# 应用连接本地邮件捕获器时使用的 SMTP 端口。
SMTP_PORT=1025
# 本地 SMTP 不启用 TLS，生产环境必须按邮件供应商要求单独配置。
SMTP_SECURE=false
# 本地邮件发送者地址，只用于识别捕获邮件来源。
MAIL_FROM=SpeechOptimizer <no-reply@speechoptimizer.local>
