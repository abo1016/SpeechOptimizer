# OpenAI 服务端密钥。只允许在服务端环境注入，禁止写入日志或浏览器构建产物。
OPENAI_API_KEY=
# 反馈模型名称。部署前应按当前 OpenAI 官方模型清单与成本要求显式确认。
OPENAI_FEEDBACK_MODEL=gpt-4o-mini
# Waffo Merchant ID。它不是 Store ID，也不是商品 ID。
WAFFO_MERCHANT_ID=
# Waffo RSA 私钥。建议由秘密管理系统注入，示例文件不得填写真实值。
WAFFO_PRIVATE_KEY=
# SMTP 主机与端口。适配层不内建 SMTP 客户端，运行时必须注入 transport。
SMTP_HOST=localhost
SMTP_PORT=1025
# Magic Link 发件地址。生产环境应使用已验证域名。
MAGIC_LINK_FROM=no-reply@example.invalid
